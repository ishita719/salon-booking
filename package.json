{
  "name": "salon-booking",
  "version": "2.0.0",
  "private": true,
  "description": "Appointment booking website for a Vancouver salon (in-salon and at-home visits). Runs on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate:local": "node scripts/local-db.mjs migrate",
    "db:migrate:remote": "wrangler d1 migrations apply salon-db --remote",
    "setup": "node scripts/local-db.mjs migrate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "wrangler d1 migrations apply salon-db --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:sql:local": "node scripts/local-db.mjs sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.9.6",
    "next": "^15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  }
}
