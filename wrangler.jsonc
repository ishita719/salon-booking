// Cloudflare Workers configuration for the salon website.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salon-booking",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // The database is Supabase (PostgreSQL). Its connection string is the secret DATABASE_URL
  // (Cloudflare → Workers & Pages → salon-booking → Settings → Variables and Secrets).
  "observability": { "enabled": true }
}
