# Local development: copy this file to BOTH `.env` and `.dev.vars` and fill in the values. Never commit them.
# In production, add the same names in Cloudflare → Workers & Pages → salon-booking → Settings → Variables and Secrets
# (type "Secret").

# Supabase database (PostgreSQL). Supabase → your project → Connect → "Transaction pooler" → copy the URI and
# put your database password in place of [YOUR-PASSWORD]. Then run:  npm run db:setup
# (Offline testing instead: npm run db:offline and use postgresql://postgres:postgres@localhost:5433/postgres)
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres"

# Long random string (32+ characters) used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# One-time code to create the OWNER account at /team/setup (only works while no owner exists).
SETUP_CODE="choose-a-private-setup-code"

# Optional: send real confirmation emails through Resend (https://resend.com).
# Leave empty and emails are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Maple & Mane <bookings@yourdomain.com>"

# Online payments with Stripe (https://dashboard.stripe.com → Developers → API keys).
# Use TEST keys (sk_test_...) until you're ready to take real money. Leave empty to offer "pay at salon" only.
STRIPE_SECRET_KEY=""
# Stripe → Developers → Webhooks → endpoint https://<your-site>/api/payments/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=""
