# Copy this file to .env and fill in real values. Never commit .env.

# Local development uses a SQLite file. In production (Vercel) use a Postgres URL
# and change `provider` in prisma/schema.prisma to "postgresql" (see README).
DATABASE_URL="file:./dev.db"

# Long random string (32+ characters) used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Owner account created by `npm run setup` (use a long unique password!)
OWNER_EMAIL="owner@salon.test"
OWNER_PASSWORD="change-me-Str0ng!"
OWNER_NAME="Salon Owner"

# Optional, for local demos only: gives the 3 seeded stylists staff logins
# (aiko@salon.test, marco@salon.test, priya@salon.test) with this password.
# Leave EMPTY in production — add real staff from the Owner > Team page instead.
STAFF_PASSWORD=""

# Optional: send real confirmation emails through Resend (https://resend.com).
# Leave empty and emails are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Maple & Mane <bookings@yourdomain.com>"
